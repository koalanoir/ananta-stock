NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publique utilisée notamment par les confirmations Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Envoi des factures PDF. L’adresse doit appartenir à un domaine validé dans Resend.
RESEND_API_KEY=re_xxxxxxxxx
INVOICE_FROM_EMAIL=Ananta Stock <factures@your-domain.com>

# Administration de la plateforme (/admin/login).
# Utilisez un mot de passe long et un secret aléatoire d’au moins 32 caractères.
# ADMIN_SESSION_SECRET signe aussi l’instantané des droits chargé à la connexion.
ADMIN_USERNAME=platform-admin
ADMIN_PASSWORD=change-me-with-a-long-password
ADMIN_SESSION_SECRET=change-me-with-a-random-32-character-secret
